{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"lib": ["ES2020", "DOM"],
		"strict": true,
		"noEmit": true,
		"moduleDetection": "force",
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"alt1": ["vendor/alt1/base"],
			"alt1/*": ["vendor/alt1/*"]
		},
		"types": []
	},
	"files": ["src/app.ts", "src/env.d.ts", "vendor/alt1/base/declarations.ts", "vendor/alt1/base/alt1api.ts"]
}
